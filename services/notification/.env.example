# Copy to .env in this folder when running this service outside Docker.
# Docker Compose has its own defaults in docker-compose.yml. Never commit .env.
PORT=9108
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
FROM_EMAIL=noreply@skillfyme.com
LOG_LEVEL=info
