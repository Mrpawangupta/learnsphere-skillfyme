# Copy to .env in this folder when running this service outside Docker.
# Docker Compose has its own defaults in docker-compose.yml. Never commit .env.
PORT=4000
NODE_ENV=development
JWT_SECRET=CHANGE_ME_use_a_64char_random_string
DATABASE_URL=postgresql://skillfyme:skillfyme_secret@localhost:5432/skillfyme
